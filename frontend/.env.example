# Copy to .env.local and fill in per environment. Never commit a real value.
VITE_API_BASE_URL=http://localhost:3000

# Intercepts network calls with the MSW mock backend (spec 0002).
# Set to 'false' the moment a real backend exists at VITE_API_BASE_URL,
# so mocks can never silently mask a real integration failure.
VITE_ENABLE_MOCKS=true
